{
  "sheet_rules": {
    "header_scan_rows": 30,
    "data_sample_rows": 120,
    "sample_column_scan_limit": 180,
    "empty_gap_limit": 20,
    "preferred_sheet_names": [
      "order",
      "Cost"
    ]
  },
  "sheet_selection": {
    "sequential_numeric_header_penalty": 500,
    "reject_header_keywords": [
      "Dropshipping price",
      "Product Description",
      "Photos",
      "Payment Way",
      "Picture",
      "Item No.",
      "Item  No",
      "Client No."
    ]
  },
  "performance": {
    "quick_header_scan_max_mb": 120,
    "quick_shared_strings_max_mb": 32,
    "processing_workbook_max_mb": 512,
    "processing_xml_entry_max_mb": 256,
    "processing_shared_strings_max_mb": 128,
    "processing_max_rows": 400000,
    "processing_workers": 11
  },
  "pricing": {
    "country_identity": [
      "iso2",
      "english",
      "chinese"
    ],
    "single_shipment_price_marker_aliases": [
      "单独发货价格",
      "单独发货价",
      "单独发货报价"
    ],
    "single_shipment_matching_enabled": false,
    "single_shipment_match_fields": [
      "recipient_name",
      "phone"
    ]
  },
  "fields": {},
  "pricing_fields": {
    "order": {
      "order_number": {
        "header_aliases": [
          "Order number-PY",
          "Order number",
          "订单号",
          "店铺单号"
        ],
        "value_patterns": [
          "^[A-Za-z]+[0-9]+(?:#[0-9]+)?$",
          "^(?:[A-Za-z][A-Za-z0-9-]*[0-9][A-Za-z0-9-]*|[0-9][A-Za-z0-9-]*[A-Za-z][A-Za-z0-9-]*)$"
        ]
      },
      "country_code": {
        "header_aliases": [
          "收货国家二字码",
          "国家二字码",
          "Country",
          "Shipping Country",
          "Shipping: Country",
          "Country/Region"
        ],
        "value_patterns": [
          "^[A-Z]{2}$"
        ]
      },
      "country_english": {
        "header_aliases": [
          "Country",
          "收货国家名称",
          "收货人国家",
          "国家",
          "Shipping: Country"
        ],
        "value_patterns": [
          "^[A-Z][A-Za-z\\s\\-()]{3,}$"
        ],
        "negative_patterns": [
          "^[A-Z]{2}$"
        ]
      },
      "country_chinese": {
        "header_aliases": [
          "Country",
          "国家",
          "国家中文",
          "收货人国家中文",
          "中文国家名",
          "国家名中文"
        ],
        "value_patterns": [
          "[\\u4e00-\\u9fff]"
        ]
      },
      "sku": {
        "header_aliases": [
          "SKU",
          "核价SKU",
          "Line: SKU",
          "SKU 1",
          "Item No.",
          "产品编码",
          "商品编码"
        ],
        "value_patterns": [
          "(?i)^[a-z0-9][a-z0-9+._-]{2,}$"
        ]
      },
      "product_name": {
        "header_aliases": [
          "Product name",
          "产品名称",
          "商品名称",
          "产品名",
          "商品名"
        ]
      },
      "quantity": {
        "header_aliases": [
          "Qty",
          "Quantity",
          "数量",
          "产品数量",
          "产品总数",
          "Total number of products",
          "Line: Fulfillable Quantity",
          "Lineitem quantity",
          "导单数量",
          "核价Qty"
        ],
        "value_patterns": [
          "^\\d+(?:\\.0+)?$"
        ]
      },
      "price": {
        "header_aliases": [
          "TOTAL Price",
          "Total price",
          "Price",
          "Cost"
        ],
        "negative_headers": [
          "Product shipping VAT tax"
        ]
      },
      "recipient_name": {
        "header_aliases": [
          "Name",
          "收件人",
          "收货人",
          "收件人姓名",
          "收货人姓名"
        ]
      },
      "phone": {
        "header_aliases": [
          "Phone",
          "Phone number",
          "Telephone",
          "Mobile",
          "电话",
          "联系电话",
          "手机",
          "手机号码",
          "收件人电话"
        ]
      },
      "postal_code": {
        "header_aliases": [
          "Zip code",
          "Zipcode",
          "Postal code",
          "Postcode",
          "Code",
          "邮编",
          "邮政编码"
        ]
      },
      "address": {
        "header_aliases": [
          "Address",
          "Address1",
          "Address2",
          "Street",
          "Street address",
          "地址",
          "地址1",
          "地址2",
          "详细地址"
        ]
      },
      "email": {
        "header_aliases": [
          "Email",
          "BuyerEmail",
          "收件人邮箱",
          "邮箱"
        ]
      }
    },
    "pricing": {
      "sku": {
        "header_aliases": [
          "Item No.",
          "Item number",
          "SKU"
        ],
        "value_patterns": [
          "(?i)^[a-z0-9][a-z0-9+._-]{2,}$"
        ]
      },
      "country": {
        "header_aliases": [
          "Country",
          "国家",
          "Country code",
          "国家代码",
          "国家二字码"
        ],
        "value_patterns": [
          "(?i)^(?:[a-z]{2}|[a-z][a-z .'-]{2,}|.*[\\u4e00-\\u9fff].*)$"
        ]
      },
      "fixed_price": {
        "header_aliases": [
          "Product shipping VAT tax",
          "Shipping VAT tax",
          "Price",
          "Cost"
        ],
        "negative_headers": [
          "Shipping Country"
        ],
        "value_patterns": [
          "^-?\\d+(?:\\.\\d+)?$"
        ]
      }
    }
  },
  "output": {
    "max_sku_groups": 3,
    "summary_flush_files": 60,
    "summary_flush_rows": 100000,
    "manifest_flush_files": 150,
    "manifest_flush_seconds": 60
  },
  "automation": {
    "auto_run": true,
    "coverage_threshold": 1,
    "min_trial_rows": 100000,
    "candidate_score_gap": 0.01,
    "template_match_priority": true
  }
}
