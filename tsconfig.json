{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["frontend/src/*"],
      "@shared/*": ["shared/*"]
    },
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vite/client", "vitest/globals", "vitest/jsdom"]
  },
  "include": [
    "electron.vite.config.ts",
    "backend/electron/**/*.ts",
    "frontend/**/*.ts",
    "frontend/**/*.tsx",
    "shared/**/*.ts",
    "test/**/*.ts",
    "test/**/*.tsx"
  ]
}
