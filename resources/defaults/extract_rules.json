        "header_aliases": [
          "Address",
          "Address1",
          "Address2",
          "Street",
          "Street address",
          "地址",
          "地址1",
          "地址2",
          "详细地址"
        ]
      },
      "email": {
        "header_aliases": [
          "Email",
          "BuyerEmail",
          "收件人邮箱",
          "邮箱"
        ]
      }
    },
    "pricing": {
