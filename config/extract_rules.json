{
  "runtime": {
    "recent_input_dir": "",
    "recent_output_dir": "",
    "recent_config_path": "",
    "archive_standard_files": false,
    "auto_reveal_manual_result": false
  },
  "sheet_rules": {
    "header_scan_rows": 30,
    "data_sample_rows": 120,
    "sample_column_scan_limit": 180,
    "empty_gap_limit": 20,
    "preferred_sheet_names": [
      "order",
      "Cost"
    ]
  },
  "sheet_selection": {
    "sequential_numeric_header_penalty": 500,
    "reject_header_keywords": [
      "Dropshipping price",
      "Product Description",
      "Photos",
      "Payment Way",
      "Picture",
      "Item No.",
      "Item  No",
      "Client No."
    ]
  },
  "performance": {
    "quick_header_scan_max_mb": 120,
    "quick_shared_strings_max_mb": 32,
    "processing_workbook_max_mb": 512,
    "processing_xml_entry_max_mb": 256,
    "processing_shared_strings_max_mb": 128,
    "processing_max_rows": 400000,
    "processing_workers": 11
  },
  "pricing": {
    "country_identity": [
      "iso2",
      "english",
      "chinese"
    ],
    "match_by_shipping_method": false,
    "single_shipment_price_marker_aliases": [
      "单独发货价格",
      "单独发货价",
      "单独发货报价"
    ],
    "sku_qty_pair_selection": "max_match_coverage",
    "quantity_policy": "nearest",
    "multiply_quantity_by_price": true,
    "zero_price_is_valid": true,
    "unavailable_price_tokens": [
      "/",
      "未核价",
      "#VALUE!",
      "#N/A"
    ],
    "output_sheets": [
      "核价结果",
      "核价异常",
      "字段映射"
    ]
  },
  "fields": {},
  "pricing_fields": {
    "order": {
      "order_number": {
        "header_aliases": [
          "Order number-PY",
          "Order number",
          "订单号",
          "店铺单号"
        ],
        "value_patterns": [
          "^[A-Za-z]+[0-9]+(?:#[0-9]+)?$",
          "^(?:[A-Za-z][A-Za-z0-9-]*[0-9][A-Za-z0-9-]*|[0-9][A-Za-z0-9-]*[A-Za-z][A-Za-z0-9-]*)$"
        ]
      },
      "country_code": {
        "header_aliases": [
          "收货国家二字码",
          "国家二字码",
          "Country",
          "Shipping Country",
          "Shipping: Country",
          "Country/Region"
        ],
        "value_patterns": [
          "^[A-Z]{2}$"
        ]
      },
      "country_english": {
        "header_aliases": [
          "Country",
          "收货国家名称",
          "收货人国家",
          "国家",
          "Shipping: Country"
        ],
        "value_patterns": [
          "^[A-Z][A-Za-z\\s\\-()]{3,}$"
        ],
        "negative_patterns": [
          "^[A-Z]{2}$"
        ]
      },
      "country_chinese": {
        "header_aliases": [
          "Country",
          "国家",
          "国家中文",
          "收货人国家中文",
          "中文国家名",
          "国家名中文"
        ],
        "value_patterns": [
          "[\\u4e00-\\u9fff]"
        ]
      },
      "sku": {
        "header_aliases": [
          "SKU",
          "核价SKU",
          "Line: SKU",
          "SKU 1",
          "Item No.",
          "产品编码",
          "商品编码"
        ],
        "value_patterns": [
          "(?i)^[a-z0-9][a-z0-9+._-]{2,}$"
        ]
      },
      "product_name": {
        "header_aliases": [
          "Product name",
          "产品名称",
          "商品名称",
          "产品名",
          "商品名"
        ]
      },
      "quantity": {
        "header_aliases": [
          "Qty",
          "Quantity",
          "数量",
          "产品数量",
          "产品总数",
          "Total number of products",
          "Line: Fulfillable Quantity",
          "Lineitem quantity",
          "导单数量",
          "核价Qty"
        ],
        "value_patterns": [
          "^\\d+(?:\\.0+)?$"
        ]
      },
      "shipping_method": {
        "header_aliases": [
          "Shipping method",
          "物流方式",
          "运输方式",
          "配送方式",
          "物流",
          "Shipping",
          "Transportation"
        ],
        "negative_headers": [
          "Shipping Country",
          "Product shipping VAT tax",
          "TAX"
        ]
      },
      "price": {
        "header_aliases": [
          "TOTAL Price",
          "Total price",
          "Price",
          "Cost"
        ],
        "negative_headers": [
          "Product shipping VAT tax"
        ]
      }
    },
    "pricing": {
      "sku": {
        "header_aliases": [
          "Item No.",
          "Item number",
          "SKU"
        ],
        "value_patterns": [
          "(?i)^[a-z0-9][a-z0-9+._-]{2,}$"
        ]
      },
      "country": {
        "header_aliases": [
          "Country",
          "国家",
          "Country code",
          "国家代码",
          "国家二字码"
        ],
        "value_patterns": [
          "(?i)^(?:[a-z]{2}|[a-z][a-z .'-]{2,}|.*[\\u4e00-\\u9fff].*)$"
        ]
      },
      "shipping_method": {
        "header_aliases": [
          "Shipping method",
          "物流方式",
          "运输方式",
          "配送方式",
          "Shipping"
        ],
        "negative_headers": [
          "Shipping Country",
          "Product shipping VAT tax"
        ]
      },
      "fixed_price": {
        "header_aliases": [
          "Product shipping VAT tax",
          "Shipping VAT tax",
          "Price",
          "Cost"
        ],
        "negative_headers": [
          "Shipping Country"
        ],
        "value_patterns": [
          "^-?\\d+(?:\\.\\d+)?$"
        ]
      }
    }
  },
  "output": {
    "max_sku_groups": 3,
    "summary_flush_files": 60,
    "summary_flush_rows": 100000,
    "manifest_flush_files": 150,
    "manifest_flush_seconds": 60
  },
  "automation": {
    "auto_run": true,
    "coverage_threshold": 1,
    "min_trial_rows": 50,
    "candidate_score_gap": 2,
    "template_match_priority": true
  }
}
