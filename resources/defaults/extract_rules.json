          "(?i)^(?:#?[a-z0-9]+(?:[-_][a-z0-9]+)+|#?\\d{4,})$"
        ]
      },
      "country_code": {
        "header_aliases": [
          "国家二字码",
          "国家代码",
          "Country code",
          "ISO",
          "Country"
        ],
        "value_patterns": [
          "(?i)^[a-z]{2}$"
        ]
      },
      "country_english": {
        "header_aliases": [
          "Country/Region",
          "Shipping Country",
          "Country",
          "英文国家名",
          "收货人国家",
          "配送国家"
        ],
        "value_patterns": [
          "(?i)^[a-z][a-z .'-]{2,}$"
        ],
