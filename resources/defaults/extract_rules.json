{
  "sheet_rules": {
    "header_scan_rows": 30,
    "data_sample_rows": 120,
    "sample_column_scan_limit": 180,
    "empty_gap_limit": 20,
    "preferred_sheet_names": [
      "Cost",
      "cost",
      "Order",
      "order"
    ]
  },
  "sheet_selection": {
    "sequential_numeric_header_penalty": 500,
    "reject_header_keywords": [
      "Dropshipping price",
      "Payment Way",
      "Picture",
      "Item No.",
      "Description",
      "Clients",
      "描述",
      "图片"
    ]
  },
  "performance": {
    "quick_header_scan_max_mb": 120,
    "quick_shared_strings_max_mb": 32,
    "processing_workbook_max_mb": 512,
    "processing_xml_entry_max_mb": 256,
    "processing_shared_strings_max_mb": 128,
    "processing_max_rows": 1000000,
    "processing_workers": 0
  },
  "automation": {
    "auto_run": true,
    "template_match_priority": true,
    "coverage_threshold": 1,
    "min_trial_rows": 20000,
    "candidate_coverage_gap": 0.01,
    "candidate_score_gap": 0.01
  },
  "pricing": {
    "country_identity": [
      "iso2",
      "english",
      "chinese"
    ],
    "single_shipment_price_marker_aliases": [
      "单独发货价格",
      "单独发货",
      "单独发货报价"
    ],
    "single_shipment_matching_enabled": false,
    "single_shipment_match_fields": [
      "recipient_name",
      "phone",
      "postal_code"
    ]
  },
  "fields": {},
  "pricing_fields": {
    "order": {
      "order_number": {
        "header_aliases": [
          "Order number-PY"
        ],
        "value_patterns": [
          "(?i)^(?:#?[a-z0-9]+(?:[-_][a-z0-9]+)+|#?\\d{4,})$"
        ]
      },
      "country_code": {
        "header_aliases": [
          "Country",
          "Country code",
          "国家二字码",
          "国家代码",
          "ISO"
        ],
        "value_patterns": [
          "(?i)^[a-z]{2}$"
        ]
      },
      "country_english": {
        "header_aliases": [
          "Country",
          "英文国家名"
        ],
        "value_patterns": [
          "(?i)^[a-z][a-z .'-]{2,}$"
        ],
        "negative_patterns": [
          "(?i)^[a-z]{2}$"
        ]
      },
      "country_chinese": {
        "header_aliases": [
          "Country",
          "中文国家名"
        ],
        "value_patterns": [
          "[\\u4e00-\\u9fff]"
        ]
      },
      "sku": {
        "header_aliases": [
          "核价SKU",
          "SKU"
        ],
        "value_patterns": [
          "(?i)^[a-z0-9][a-z0-9+._-]{2,}$"
        ]
      },
      "product_name": {
        "header_aliases": [
          "Product name",
          "产品名称"
        ]
      },
      "quantity": {
        "header_aliases": [
          "Quantity",
          "Qty",
          "产品总数"
        ],
        "value_patterns": [
          "^\\d+(?:\\.0+)?$"
        ]
      },
      "price": {
        "header_aliases": [
          "TOTAL Price",
          "Total price",
          "Price"
        ],
        "negative_headers": [
          "Product shipping VAT tax"
        ]
      },
      "recipient_name": {
        "header_aliases": [
          "Name",
          "收件人",
          "收货人",
          "收件人姓名",
          "收货人姓名"
        ]
      },
      "phone": {
        "header_aliases": [
          "Phone",
          "Phone number",
          "Telephone",
          "电话",
          "联系电话",
          "手机",
          "手机号码",
          "收件人电话"
        ]
      },
      "postal_code": {
        "header_aliases": [
          "Zip code",
          "Zipcode",
          "Postal code",
          "Postcode",
          "Code",
          "邮编",
          "邮政编码"
        ]
      },
      "address": {
        "header_aliases": [
          "Address",
          "Address1",
          "Address2",
          "Street",
          "Street address",
          "地址",
          "地址1",
          "地址2",
          "详细地址"
        ]
      },
      "email": {
        "header_aliases": [
          "Email",
          "BuyerEmail",
          "收件人邮箱",
          "邮箱"
        ]
      }
    },
    "pricing": {
      "sku": {
        "header_aliases": [
          "Item No.",
          "Item  No.",
          "SKU"
        ],
        "value_patterns": [
          "(?i)^[a-z0-9][a-z0-9+._-]{2,}$"
        ]
      },
      "country": {
        "header_aliases": [
          "country",
          "国家",
          "Country"
        ],
        "value_patterns": [
          "(?i)^(?:[a-z]{2}|[a-z][a-z .'-]{2,}|.*[\\u4e00-\\u9fff].*)$"
        ]
      },
      "quantity_one_price": {
        "header_aliases": [
          "Price",
          "Cost",
          "价格"
        ],
        "negative_headers": [
          "Shipping Country"
        ],
        "value_patterns": [
          "^-?\\d+(?:\\.\\d+)?$"
        ]
      }
    }
  },
  "output": {
    "extracted_sku_group_limit": 3,
    "summary_buffer_file_limit": 60,
    "summary_buffer_row_limit": 100000
  }
}