        "header_aliases": [
          "Item No.",
          "Item number",
          "核价SKU",
          "SKU",
          "货号",
          "产品编码",
          "商品编码"
        ],
        "value_patterns": [
          "(?i)^[a-z0-9][a-z0-9+._-]{2,}$"
        ]
      },
      "country": {
        "header_aliases": [
          "Country",
          "国家",
          "Country code",
          "国家代码",
