      },
      "fixed_price": {
        "header_aliases": [
          "Product shipping VAT tax",
          "Shipping VAT tax",
          "Price",
          "Cost",
          "价格",
          "核价",
          "单价"
        ],
        "negative_headers": [
          "Shipping Country"
        ],
        "value_patterns": [
          "^-?\\d+(?:\\.\\d+)?$"
