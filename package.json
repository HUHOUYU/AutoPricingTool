{
  "name": "auto-pricing-tool",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.13.0",
  "description": "Automatic Excel order pricing tool.",
  "main": "out/main/index.js",
  "type": "module",
  "config": {
    "electron_mirror": "https://npmmirror.com/mirrors/electron/"
  },
  "scripts": {
    "predev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build_processor.ps1 -Dev",
    "dev": "electron-vite dev",
    "build:processor:dev": "powershell -ExecutionPolicy Bypass -File scripts/build_processor.ps1 -Dev",
    "build:processor": "powershell -ExecutionPolicy Bypass -File scripts/build_processor.ps1",
    "build": "electron-vite build",
    "dist:win": "powershell -ExecutionPolicy Bypass -File scripts/build_exe.ps1",
    "preview": "electron-vite preview",
    "test": "pnpm run test:processor && pnpm run test:ui",
    "test:processor": "powershell -ExecutionPolicy Bypass -File scripts/build_processor.ps1 -Test",
    "check:processor": "powershell -ExecutionPolicy Bypass -File scripts/build_processor.ps1 -Check",
    "test:ui": "vitest run",
    "typecheck": "tsc --noEmit",
    "format:check": "cargo fmt --manifest-path backend/processor/Cargo.toml --all -- --check",
    "lint:processor": "cargo clippy --manifest-path backend/processor/Cargo.toml --all-targets --all-features --locked -- -D warnings",
    "quality": "pnpm run format:check && pnpm run lint:processor && pnpm run typecheck && pnpm test && pnpm run build"
  },
  "build": {
    "appId": "com.autopricingtool.app",
    "productName": "AutoPricingTool",
    "artifactName": "AutoPricingTool.${ext}",
    "asar": true,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/defaults",
        "to": "config",
        "filter": [
          "extract_rules.json"
        ]
      },
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "app-icon.ico",
          "app-icon.png",
          "app-icon.svg"
        ]
      },
      {
        "from": "resources/licenses",
        "to": "licenses",
        "filter": [
          "*.txt"
        ]
      },
      {
        "from": "resources/defaults",
        "to": "defaults",
        "filter": [
          "extract_rules.json"
        ]
      },
      {
        "from": "backend/processor/target/release",
        "to": "processor",
        "filter": [
          "auto-pricing-tool-processor.exe"
        ]
      }
    ],
    "win": {
      "icon": "resources/app-icon.ico",
      "executableName": "AutoPricingTool",
      "target": [
        "portable"
      ]
    }
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "echarts": "^6.1.0",
    "exceljs": "^4.4.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.23.0",
    "motion": "^12.42.2",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-dropzone": "^17.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.9"
  }
}
